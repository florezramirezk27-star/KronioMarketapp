<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema aplicado a la ventana de Android mientras arranca el proceso,
         con el modo oscuro del sistema desactivado. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <!-- Tema aplicado en cuanto arranca el proceso. Determina el fondo de la
         ventana mientras Flutter inicializa y detras de la UI.

         Solo se usa a partir de V2 del embedding de Flutter. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/kronio_surface_light</item>
    </style>
</resources>
