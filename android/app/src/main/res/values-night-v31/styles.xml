<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Igual que `values-v31/styles.xml`, pero con el fondo oscuro. Sin esto,
         abrir la app de noche en Android 12+ muestra un splash blanco. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/kronio_surface_dark</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/kronio_surface_dark</item>
    </style>
</resources>
