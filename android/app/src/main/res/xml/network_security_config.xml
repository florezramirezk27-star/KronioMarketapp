<?xml version="1.0" encoding="utf-8"?>
<!--
  Politica de red de Android.

  Desde Android 9 (API 28) el trafico cleartext (HTTP) esta bloqueado por
  defecto. Sin este archivo, el comando de desarrollo documentado en el README
  (flutter run apuntando KRONIO_API_URL a http://10.0.2.2:3000) falla con una
  excepcion de socket en emuladores y dispositivos actuales.

  En vez de abrir HTTP para todo con android:usesCleartextTraffic="true", que
  dejaria el release hablando en texto plano con cualquier host, aqui se
  permite cleartext SOLO contra el backend local. Todo lo demas sigue exigiendo
  HTTPS, tambien en release.
-->
<network-security-config>

    <!-- Produccion: solo HTTPS, con los certificados del sistema. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!--
      Desarrollo: HTTP permitido unicamente contra el host local.

        10.0.2.2    alias que usa el emulador de Android para el localhost del PC
        localhost   y 127.0.0.1 para pruebas en el propio dispositivo

      En un dispositivo real ninguno de estos dominios resuelve a un servidor
      remoto, asi que el permiso no expone nada en produccion.
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>

</network-security-config>
