<?xml version="1.0" encoding="utf-8"?>
<!-- Splash de arranque en modo oscuro. El logo es el mismo; solo cambia el
     fondo, para que no se vea un destello blanco al abrir la app de noche. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/kronio_surface_dark" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_logo" />
    </item>
</layer-list>
